# Referencia para Variables de Railway. No contiene credenciales reales.
PORT=3000
ROOT_URL=https://REEMPLAZAR.up.railway.app
NODE_ENV=production
DEPLOY_METHOD=docker
# Guardar la URI completa como secret; MongoDB requiere un replica set.
MONGO_URL=mongodb://USUARIO:CLAVE@HOST:27017/rocketchat?replicaSet=rs0&authSource=admin
OVERWRITE_SETTING_Site_Name=Mexillum
OVERWRITE_SETTING_Language=es
OVERWRITE_SETTING_Accounts_RegistrationForm=Disabled
# Configurar SMTP y almacenamiento S3 en administración antes de invitar al equipo.
